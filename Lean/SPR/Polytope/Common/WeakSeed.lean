import SPR.Polytope.QuarticTriangle.Exclusion

/-! # Exact seven-node weak obstruction for a fixed outward perturbation.
This file proves the algebraic weak obstruction. Stability is not asserted here. -/
namespace SPR.Polytope.WeakSeed
open Polynomial
noncomputable section
set_option maxHeartbeats 2000000

abbrev G := QuarticTriangle.G

def a0 : N4.Poly4 := ⟨(1999993/6999993 : ℝ),(12333317/2333331 : ℝ),(999998/999999 : ℝ),(8333317/2333331 : ℝ)⟩

def a1 : N4.Poly4 := ⟨(10999993/6999993 : ℝ),(31999951/6999993 : ℝ),(3999998/999999 : ℝ),(2769227/538461 : ℝ)⟩

def a2 : N4.Poly4 := ⟨(77909089/1909089 : ℝ),(1129999853/20999979 : ℝ),(19162162/81081 : ℝ),(575999951/6999993 : ℝ)⟩

def row0 (p : ℝ[X]) : ℝ := G a0 p 1

def row1 (p : ℝ[X]) : ℝ := G a1 p 2

def row2 (p : ℝ[X]) : ℝ := G a1 p 3

def row3 (p : ℝ[X]) : ℝ := G a2 p 4

def row4 (p : ℝ[X]) : ℝ := G a0 p 5

def row5 (p : ℝ[X]) : ℝ := G a2 p 6

def row6 (p : ℝ[X]) : ℝ := G a0 p 7

theorem positive_certificate (p : ℝ[X]) :
    (211035376039236633546171560012468401279/1174205692530034689001139486272777 : ℝ)*row0 p +
      (11869805717576611834861212747747898487452/10567851232770312201010255376454993 : ℝ)*row1 p +
      (3517002986472870117126344521310977376675/1174205692530034689001139486272777 : ℝ)*row2 p +
      (25775945835015093169260038026299259440/1174205692530034689001139486272777 : ℝ)*row3 p +
      (28487347523787427949375038399930767822455/31703553698310936603030766129364979 : ℝ)*row4 p +
      (2947296747875725651678442727989234836/1174205692530034689001139486272777 : ℝ)*row5 p +
      (1/1 : ℝ)*row6 p = 0 := by
  norm_num [row0,row1,row2,row3,row4,row5,row6,G,QuarticTriangle.G,a0,a1,a2]
  ring

theorem rows_force_zero (p : ℝ[X])
    (h0 : 0 ≤ row0 p)
    (h1 : 0 ≤ row1 p)
    (h2 : 0 ≤ row2 p)
    (h3 : 0 ≤ row3 p)
    (h4 : 0 ≤ row4 p)
    (h5 : 0 ≤ row5 p)
    (h6 : 0 ≤ row6 p) :
    row0 p=0 ∧ row1 p=0 ∧ row2 p=0 ∧ row3 p=0 ∧ row4 p=0 ∧ row5 p=0 ∧ row6 p=0 := by
  have h := positive_certificate p
  constructor
  · nlinarith
  constructor
  · nlinarith
  constructor
  · nlinarith
  constructor
  · nlinarith
  constructor
  · nlinarith
  constructor <;> nlinarith

theorem coefficients_zero (p : ℝ[X])
    (h0 : row0 p=0)
    (h1 : row1 p=0)
    (h2 : row2 p=0)
    (h3 : row3 p=0)
    (h4 : row4 p=0)
    (h5 : row5 p=0) :
    p.coeff 0=0 ∧ p.coeff 1=0 ∧ p.coeff 2=0 ∧ p.coeff 3=0 ∧ p.coeff 4=0 ∧ p.coeff 5=0 := by
  simp only [row0,row1,row2,row3,row4,row5,G,QuarticTriangle.G,a0,a1,a2] at h0 h1 h2 h3 h4 h5
  constructor
  · linear_combination (-10260650226093008789414204605457484795/1174205692530034689001139486272777 : ℝ)*h0 + (-64109134792234651794751667005189134360/1174205692530034689001139486272777 : ℝ)*h1 + (-170964030039375547722573480182830692390/1174205692530034689001139486272777 : ℝ)*h2 + (-1253003752167638845253897275029827055/1174205692530034689001139486272777 : ℝ)*h3 + (-51290089123609110271771742181004930639/1174205692530034689001139486272777 : ℝ)*h4 + (-143271206925945829591945077378034650/1174205692530034689001139486272777 : ℝ)*h5
  constructor
  · linear_combination (-5861258751805936090640755301681067221441181/2348411385060069378002278972545554000000 : ℝ)*h0 + (-7326057144936287843495392407266946344058819/469682277012013875600455794509110800000 : ℝ)*h1 + (-9769221123714038036736051715558776226841181/234841138506006937800227897254555400000 : ℝ)*h2 + (-71601968821016810584182926369573394858819/234841138506006937800227897254555400000 : ℝ)*h3 + (-5862009005011805291560933127744642267441181/469682277012013875600455794509110800000 : ℝ)*h4 + (-81874547029781849280065432409817952058819/2348411385060069378002278972545554000000 : ℝ)*h5
  constructor
  · linear_combination (-10259216470638083119267516206749423533955883/1174205692530034689001139486272777000000 : ℝ)*h0 + (-12822089614027160784491410157383634249194117/234841138506006937800227897254555400000 : ℝ)*h1 + (-17096433568518142559008466770831123957955883/117420569253003468900113948627277700000 : ℝ)*h2 + (-125299929892941017167551944923847197044117/117420569253003468900113948627277700000 : ℝ)*h3 + (-30773861907707433616906710490125057335467649/704523415518020813400683691763666200000 : ℝ)*h4 + (-143270315082906723111690402830159619294117/1174205692530034689001139486272777000000 : ℝ)*h5
  constructor
  · linear_combination (-2930478660392727641639183269829247957191181/2348411385060069378002278972545554000000 : ℝ)*h0 + (-3663045665351587733401692562978578894058819/469682277012013875600455794509110800000 : ℝ)*h1 + (-4884542025038324148030941857383853426691181/234841138506006937800227897254555400000 : ℝ)*h2 + (-35801151439569018241816923752619352458819/234841138506006937800227897254555400000 : ℝ)*h3 + (-8793218919542330422237214456852281790573543/1409046831036041626801367383527332400000 : ℝ)*h4 + (-40938995126944512550396685259058280058819/2348411385060069378002278972545554000000 : ℝ)*h5
  constructor
  · linear_combination (-2931120630922906509624206086744697943455883/2348411385060069378002278972545554000000 : ℝ)*h0 + (-3663471394143218982407331690333346432094117/469682277012013875600455794509110800000 : ℝ)*h1 + (-4884698693606616423555181921389206145455883/234841138506006937800227897254555400000 : ℝ)*h2 + (-35799956992942891262495368666139037294117/234841138506006937800227897254555400000 : ℝ)*h3 + (-8792514588502262138208322159707628564767649/1409046831036041626801367383527332400000 : ℝ)*h4 + (-40934568126091487149480397034125487294117/2348411385060069378002278972545554000000 : ℝ)*h5
  · linear_combination (71511656348531664221052141962593794117/2348411385060069378002278972545554000000 : ℝ)*h0 + (55140338550858298185297676821817705883/469682277012013875600455794509110800000 : ℝ)*h1 + (27857225944785358230682128796817694117/234841138506006937800227897254555400000 : ℝ)*h2 + (-130501654566803184104416913213394117/234841138506006937800227897254555400000 : ℝ)*h3 + (-114246073329956715102424632592397617649/1409046831036041626801367383527332400000 : ℝ)*h4 + (-914531277908179244025442642089294117/2348411385060069378002278972545554000000 : ℝ)*h5

/-- No nonzero arbitrary real degree-at-most-five polynomial has all seven weak contacts. -/
theorem no_nonzero_weak : ¬ ∃ p : ℝ[X], p ≠ 0 ∧ p.natDegree ≤ 5 ∧
    0 ≤ row0 p ∧ 0 ≤ row1 p ∧ 0 ≤ row2 p ∧ 0 ≤ row3 p ∧ 0 ≤ row4 p ∧ 0 ≤ row5 p ∧ 0 ≤ row6 p := by
  rintro ⟨p,hne,hd,h0,h1,h2,h3,h4,h5,h6⟩
  obtain ⟨z0,z1,z2,z3,z4,z5,z6⟩ := rows_force_zero p h0 h1 h2 h3 h4 h5 h6
  obtain ⟨c0,c1,c2,c3,c4,c5⟩ := coefficients_zero p z0 z1 z2 z3 z4 z5
  apply hne
  rw [← QuarticTriangle.numerator_eq hd]
  simp [QuarticTriangle.numerator,c0,c1,c2,c3,c4,c5]

end
end SPR.Polytope.WeakSeed
